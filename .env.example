# Copy to .env for local testing. On Render or Azure, enter these in the service's environment settings.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://policies.adkhospital.com

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Database, issued documents and signed scans (a persistent folder).
DATA_DIR=/home/data/docportal

# --- First Super Admin (created only when the portal has no active Super Admin) ---
ADMIN_EMAIL=it.manager@adkhospital.com
ADMIN_NAME=Full Name
ADMIN_DESIGNATION=IT Manager
# Temporary; must be changed at first sign-in. Delete this setting afterwards.
ADMIN_PASSWORD=

# --- Optional: Microsoft 365 sign-in (users still need a portal account) ---
# TENANT_ID=
# CLIENT_ID=
# CLIENT_SECRET=
# REDIRECT_URI=https://policies.adkhospital.com/auth/redirect

# --- Optional: e-mail notifications (needs Graph Mail.Send application permission) ---
# NOTIFY_SENDER=documents@adkhospital.com
# HR_NOTIFY_EMAIL=hr@adkhospital.com

# --- AI drafting (Claude API) ---
# Leave blank to run without AI (the portal lays the author's text into the template unchanged).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Copy to .env for local testing. In Azure, enter these as App Service "Environment variables".

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://policies.adkhospital.com

# --- Microsoft 365 sign-in (Entra ID app registration) ---
AUTH_MODE=entra
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=paste-client-secret-value
REDIRECT_URI=https://policies.adkhospital.com/auth/redirect
# Optional: only members of this security group may use the portal (needs the "groups" claim).
# ALLOWED_GROUP_ID=
# Only these e-mail domains may be named as reviewers or approvers.
ALLOWED_EMAIL_DOMAINS=adkhospital.com

# --- HR (document custodian) ---
# Members of this security group get the HR role (numbering, issue, signed copies, register export).
# HR_GROUP_ID=
# Or list HR staff directly, comma-separated:
HR_EMAILS=hr.officer@adkhospital.com
# Shared HR mailbox that receives "ready for numbering" e-mails (optional):
# HR_NOTIFY_EMAIL=hr@adkhospital.com

# --- E-mail notifications (optional; needs Graph Mail.Send application permission) ---
# NOTIFY_SENDER=documents@adkhospital.com

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- AI drafting (Claude API) ---
# Leave blank to run without AI (the portal lays the author's text into the template unchanged).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
DRAFTS_PER_HOUR=15

# --- Storage ---
# Database, issued documents and signed scans. On Azure App Service use a folder under /home so it persists and is backed up.
DATA_DIR=/home/data/docportal
